# Yandex Cloud resources of your Silk Hub (ids only; secrets live in Lockbox).
# Copy to deploy/yandex/cloud.env and fill in; deploy/yandex/cloud.env is not committed.
FOLDER_ID=
FUNCTION_NAME=silk-plugins-hub
GATEWAY_NAME=silk-plugins-hub
# Service account of the function: ydb.editor, storage.editor, lockbox.payloadViewer.
FUNCTION_SA_ID=
# Service account of the gateway: functions.functionInvoker.
GATEWAY_SA_ID=
YDB_CONNECTION_STRING=grpcs://ydb.serverless.yandexcloud.net:2135/?database=/ru-central1/<cloud id>/<database id>
S3_BUCKET=
# Lockbox secret with SESSION_SECRET, S3_ACCESS_KEY_ID, S3_SECRET_ACCESS_KEY, GOOGLE_CLIENT_SECRET.
LOCKBOX_SECRET_ID=
# Cost caps: at most this many instances and concurrent requests per zone.
ZONE_INSTANCES_LIMIT=2
ZONE_REQUESTS_LIMIT=4
MEMORY=256m
TIMEOUT=30s
