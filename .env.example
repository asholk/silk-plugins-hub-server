PORT=8787
BASE_URL=http://127.0.0.1:8787
# Random string, at least 32 characters
SESSION_SECRET=
# 1 enables /auth/dev email login when Google OAuth is not configured (local only)
DEV_LOGIN=0
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Storage: sqlite + local files by default; ydb + s3 in Yandex Cloud
STORE=sqlite
FILES=local
DATA_DIR=./data
# YDB_CONNECTION_STRING=
# S3_BUCKET=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=

# Abuse limits
REQUESTS_PER_MINUTE=300
DOWNLOADS_PER_HOUR=300
AUTH_PER_10_MIN=30
# Comma-separated IPs allowed to use the admin API; empty means any
ADMIN_ALLOWED_IPS=
